# Netlify redirect & rewrite rules for HealthyfiKey
# https://docs.netlify.com/routing/redirects/

# --- Clean URLs (serve the .html file without the extension) --------------
# Lets /articles/mediterranean-diet-guide (no .html) resolve correctly, and
# is a no-op for links that already include .html.
/articles/:slug              /articles/:slug.html            200
/legal/:slug                 /legal/:slug.html                200

# --- Back-compat / common typo redirects -----------------------------------
/home                         /                                301
/index.html                   /                                301
/privacy                      /legal/privacy-policy.html       301
/terms                        /legal/terms-and-conditions.html 301
/about                        /legal/about-us.html             301
/contact                      /legal/contact-us.html           301

# --- 404 -------------------------------------------------------------------
/*                             /404.html                        404
